        <ModifiedRev MajorVersion="25" MinorVersion="0" UserVersion="0"/>
        <Name xlate="true" UID="ID_MM_NM_D2067">Attacher le nuage de points</Name>
        <Command>^C^C_pointcloudattach</Command>
        <HelpString xlate="true" UID="ID_MM_HS_0783C">Insère un fichier RCS, RCP, E57, LAS, LAZ ou PTS dans le dessin actuel : ATTACHERNUAGEPOINTS</HelpString>
        <SmallImage Name="ZWRC_POINTCLOUDATTACH"/>
        <LargeImage Name="ZWRC_POINTCLOUDATTACH"/>
        <CLICommand xlate="true" UID="ID_MM_CLIC_1C1B5">ATTACHERNUAGEPOINTS</CLICommand>
      </Macro>
    </MenuMacro>
    <MenuMacro UID="ID_PCExport">
